{
  // Cloudflare runs `npx wrangler deploy` from the repo root. A config here
  // stops Wrangler from trying to guess which workspace package to publish.
  // Local `wrangler dev` still uses apps/signal/wrangler.jsonc.
  "name": "snescouch",
  "main": "apps/signal/src/index.ts",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // O save na nuvem está desligado por custo. Não recolocar o R2. Ver AGENTS.md.
  // MERCADO_PAGO_URL é secret do Worker. O link não fica neste arquivo.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snes-couch",
      "database_id": "a5cb9ff2-a92a-4da7-8906-4a9bb5244724"
    }
  ]
}
