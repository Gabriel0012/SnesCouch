# TURN opcional, para quem está atrás de CGNAT.
# Sem isso, a sala ainda tenta ligação direta e STUN.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Discord: https://discord.com/developers/applications
# OAuth2 → Redirect: http://localhost:5173/api/auth/discord/callback
# Escopo: identify
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Botão “Pague-me um café”. Sem o link, o botão fica escondido.
MERCADO_PAGO_URL=

# Google: https://console.cloud.google.com/apis/credentials
# URI de redirecionamento: http://localhost:5173/api/auth/google/callback
# Escopos: openid profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
