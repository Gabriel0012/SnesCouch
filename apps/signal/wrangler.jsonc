{
  "name": "snes-couch",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-06",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // `wrangler d1 create snes-couch` e cole o database_id antes de publicar.
  // `wrangler r2 bucket create snes-couch-saves`
  // O id abaixo serve ao `wrangler dev` local.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snes-couch",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SAVES",
      "bucket_name": "snes-couch-saves"
    }
  ]
}
